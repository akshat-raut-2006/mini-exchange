<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.matchingengine</groupId>
    <artifactId>matching-engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>api-server</artifactId>
  <packaging>jar</packaging>

  <name>Mini Exchange - API Server</name>
  <description>
    REST + WebSocket API in front of engine-core, with Supabase (Postgres)
    persistence for orders and trades, and Supabase Auth (JWT) for
    identifying which user placed each order.
  </description>

  <properties>
    <spring-boot.version>3.3.0</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.matchingengine</groupId>
      <artifactId>engine-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      Plain JDBC (Spring's JdbcTemplate) rather than JPA/Hibernate: for a
      schema this small (orders, trades) hand-written SQL is less risk than
      fighting an ORM. Revisit if the schema grows.

      Persistence target is Supabase (managed Postgres), hence the
      PostgreSQL driver below.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.4</version>
    </dependency>

    <!--
      Loads api-server/.env automatically on startup (SUPABASE_DB_URL,
      SUPABASE_DB_USER, SUPABASE_DB_PASSWORD, SUPABASE_JWT_SECRET) so
      `mvn spring-boot:run` works with no manual `export`/`source` step.
      .env itself is gitignored and never committed.
    -->
    <dependency>
      <groupId>me.paulschwarz</groupId>
      <artifactId>spring-dotenv</artifactId>
      <version>4.0.0</version>
    </dependency>

    <!--
      Verifies the Supabase Auth JWT sent by the dashboard on order
      submission (see auth/JwtAuthFilter.java). Supabase signs tokens with
      an asymmetric key (ES256) and publishes the matching public key via
      a JWKS endpoint - nimbus-jose-jwt handles fetching/caching that key
      set and verifying against it. Supabase itself still owns
      login/signup/password storage; the backend only ever verifies.
    -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.40</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>
</project>